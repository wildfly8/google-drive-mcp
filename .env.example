MCP_AUTH_TOKEN=
MCP_PRINCIPAL_ID=deployment-1
MCP_PUBLIC_URL=https://<your-service>.a.run.app
# Optional dedicated JWT HMAC material. If unset, derived from MCP_AUTH_TOKEN.
# MCP_OAUTH_SIGNING_KEY=
# Without the paywall, true skips the /consent password page. With the paywall on, every
# Connect shows an Allow page to the paying subscriber whatever this is set to.
# MCP_OAUTH_AUTO_APPROVE=true
# Mandatory $20/month (Stripe Checkout). Operator KYC is in Stripe Dashboard, not this origin.
# MCP_SUBSCRIPTION_REQUIRED=true
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID=
# Google Identity Platform API key for emailed sign-in links (continue a subscription elsewhere).
# IDENTITY_TOOLKIT_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Required. Only this folder (kb) and its descendants are readable; nothing
# else can be read or listed. The server refuses to start without it.
DRIVE_ALLOWED_FOLDER_ID=<kb-folder-id>
